EXPO_PUBLIC_API_BASE_URL=https://sayso.co.za
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token
EXPO_PUBLIC_MAPBOX_WEB_PIN_URL=https://your-cdn.example.com/sayso-map-pin.png
# Comma-separated SPKI SHA-256 hashes. Generate with:
# openssl s_client -connect www.sayso.co.za:443 -servername www.sayso.co.za -showcerts 2>/dev/null \
#   | awk '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/' \
#   | openssl x509 -pubkey -noout | openssl pkey -pubin -outform DER \
#   | openssl dgst -sha256 -binary | openssl base64
# Include at least 2 hashes (leaf + intermediate) to survive cert rotation.
EXPO_PUBLIC_API_PINNED_KEY_HASHES=sha256/BASE64_HASH_1,sha256/BASE64_HASH_2
# Start false — collect telemetry only. Flip to true once hashes are validated in staging.
EXPO_PUBLIC_SECURITY_ENFORCE_PINNING=false
EXPO_PUBLIC_SECURITY_ENFORCE_INTEGRITY=false
EXPO_PUBLIC_SECURITY_ALLOW_EMULATOR=true

# Playwright mobile E2E (review flow). Loaded via playwright.config → dotenv/config.
# For GitHub Actions, copy these to repository secrets with the same names (do not commit .env).
E2E_PERSONAL_ACCOUNT_EMAIL=you@example.com
E2E_PERSONAL_ACCOUNT_PASSWORD=your-e2e-test-account-password
